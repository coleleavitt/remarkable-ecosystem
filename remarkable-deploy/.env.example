# remarkable-server configuration
# Copy to .env and customize

# ═══════════════════════════════════════════════════════════════
# Network Configuration
# ═══════════════════════════════════════════════════════════════

# Domain for TLS certificate (use localhost for development)
DOMAIN=localhost

# Server bind address
RM_HOST=0.0.0.0

# Server port (internal, Caddy exposes 443)
RM_PORT=8080

# ═══════════════════════════════════════════════════════════════
# Storage Configuration
# ═══════════════════════════════════════════════════════════════

# Data directory for documents and sync state
# Docker: volume mount path
# Bare metal: absolute filesystem path
RM_DATA_DIR=/data

# Certificate directory
RM_CERTS_DIR=/certs

# ═══════════════════════════════════════════════════════════════
# Server Options
# ═══════════════════════════════════════════════════════════════

# Log level: debug, info, warning, error
RM_LOG_LEVEL=info

# Maximum file upload size (bytes)
# Default: 100MB
RM_MAX_UPLOAD_SIZE=104857600

# Pairing code expiry (seconds)
# Default: 300 (5 minutes)
RM_PAIRING_CODE_EXPIRY=300

# ═══════════════════════════════════════════════════════════════
# TLS Configuration
# ═══════════════════════════════════════════════════════════════

# TLS mode: auto, manual, disabled
# - auto: Let's Encrypt via Caddy (requires public domain)
# - manual: Use provided certificates
# - disabled: HTTP only (NOT recommended)
RM_TLS_MODE=auto

# For manual TLS: paths to certificate files
# RM_TLS_CERT=/path/to/cert.pem
# RM_TLS_KEY=/path/to/key.pem

# ═══════════════════════════════════════════════════════════════
# Device Authentication
# ═══════════════════════════════════════════════════════════════

# Enable device registration (pairing)
RM_ALLOW_REGISTRATION=true

# Maximum devices per server
RM_MAX_DEVICES=10

# Require approval for new device registrations
RM_REQUIRE_APPROVAL=false

# ═══════════════════════════════════════════════════════════════
# Portal Configuration
# ═══════════════════════════════════════════════════════════════

# Enable web portal
RM_PORTAL_ENABLED=true

# Portal authentication (future)
# RM_PORTAL_AUTH=basic
# RM_PORTAL_USER=admin
# RM_PORTAL_PASSWORD=changeme

# ═══════════════════════════════════════════════════════════════
# Advanced Options
# ═══════════════════════════════════════════════════════════════

# Enable debug endpoints (DO NOT use in production)
RM_DEBUG_ENDPOINTS=false

# CORS allowed origins (comma-separated)
RM_CORS_ORIGINS=*

# Rate limiting (requests per minute)
RM_RATE_LIMIT=1000

# Worker processes (0 = auto based on CPU cores)
RM_WORKERS=0

# Cleanup old sync states (days, 0 = disabled)
RM_CLEANUP_DAYS=30
