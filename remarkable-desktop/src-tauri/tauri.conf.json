{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "remarkable-sync",
  "version": "0.1.0",
  "identifier": "com.remarkable.sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "reMarkable Sync",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "decorations": true,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "reMarkable Sync"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {}
    }
  },
  "plugins": {
    "notification": {
      "all": true
    },
    "dialog": {
      "all": true
    },
    "fs": {
      "all": true,
      "scope": [
        "$HOME/**",
        "$DATA/**",
        "$CONFIG/**"
      ]
    },
    "store": {},
    "log": {
      "level": "info"
    },
    "shell": {
      "all": true,
      "execute": true,
      "sidecar": false,
      "open": true
    }
  }
}